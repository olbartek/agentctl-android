# A wrong password shows invalidCredentials; editing clears the error.
email alice@example.com
password wrong-password
submit
expect screen=auth/login error=invalidCredentials call=auth.login loading=false
password Passw0rd!
expect error=none canSubmit=true
# A forced network failure is reported, and a retry succeeds.
mock auth.login network
submit
expect error=network
submit
expect screen=home/shop products=12
