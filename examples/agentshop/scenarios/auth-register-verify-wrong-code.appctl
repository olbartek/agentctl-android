# A wrong verification code is refused; the right one signs in and starts onboarding.
register
name Grace
email grace@example.com
password Secret123
confirm Secret123
terms on
submit
expect screen=auth/register/verify email=grace@example.com
code 000000
verify
expect error=invalidCode call=auth.verifyEmail
code 123456
expect error=none canVerify=true
verify
expect screen=onboarding/welcome call=auth.verifyEmail call=account.fetchProfile
