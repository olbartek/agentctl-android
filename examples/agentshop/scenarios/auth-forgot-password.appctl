# Reset a password, then log in with the new one.
email alice@example.com
forgot
expect screen=auth/forgot/email email=alice@example.com canSend=true
send
expect screen=auth/forgot/reset call=auth.requestPasswordReset
code 000000
password NewPass123
confirm NewPass123
show-password on
show-confirm on
expect revealed=password,confirm
submit
expect screen=auth/forgot/reset error=invalidCode
code 654321
expect error=none canSubmit=true
submit
expect screen=auth/forgot/done call=auth.resetPassword
to-login
expect screen=auth/login email=alice@example.com canSubmit=false
password Passw0rd!
submit
expect error=invalidCredentials
password NewPass123
submit
expect screen=home/shop products=12
