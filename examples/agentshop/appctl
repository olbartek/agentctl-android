#!/bin/sh
# AgentShop's copy of Templates/appctl: the wrapper every AgentCtl host copies to the root of its repository.
#
# It rebuilds the host's own CLI executable incrementally (Gradle's `installDist`, a few seconds when nothing
# changed) and then execs it, so the CLI is always current and agents call `./appctl …` instead of
# `./gradlew run`, which mixes its build log into the step output a script is meant to be read from. Here the
# build log goes to stderr and a build failure exits 3, the CLI's "internal or build error" code.
#
# --- Change these two lines for your repo ---------------------------------------------------------------------
MODULE=":examples:agentshop:shopctl"  # AgentShop's CLI module
NAME="shopctl"
# ------------------------------------------------------------------------------------------------------------
#
# AgentShop is not at the root of its repository: its root is this directory (examples/agentshop), where
# `scenarios/` and `agent-commands.md` live, while the Gradle build is the repository's, two levels up. So the
# build runs from REPO, and APPCTL_ROOT names this directory. The `check` ladder's Gradle tasks run through
# ./gradlew here, which forwards to the repository's wrapper.
#
# The CLI finds the Android SDK (for `app` and `check --ui`) through ANDROID_HOME or local.properties at its root;
# the repository's local.properties is two levels up, so its sdk.dir is passed on as ANDROID_HOME when that is unset.
#
# The build needs a JDK 17 or newer: JAVA_HOME's when it has one, else the `java` on PATH, else Homebrew's
# openjdk@21. With none of them it says so and exits 3.

ROOT="$(cd "$(dirname "$0")" && pwd)"
# A JDK 17 or newer: JAVA_HOME's, else the `java` on PATH, else Homebrew's openjdk@21 (a Mac without a system JDK).
java_major() { "$1" -version 2>&1 | sed -n 's/.* version "\([0-9]*\).*/\1/p' | head -n 1; }
jdk_ok() { [ -x "$1" ] && major="$(java_major "$1")" && [ -n "$major" ] && [ "$major" -ge 17 ]; }
if ! jdk_ok "$JAVA_HOME/bin/java"; then
  if jdk_ok "$(command -v java 2>/dev/null)"; then
    unset JAVA_HOME   # Gradle then uses the java on PATH
  else
    BREW_JDK="$(brew --prefix openjdk@21 2>/dev/null)/libexec/openjdk.jdk/Contents/Home"
    if jdk_ok "$BREW_JDK/bin/java"; then
      JAVA_HOME="$BREW_JDK"; export JAVA_HOME
    else
      echo "$(basename "$0"): no JDK 17 or newer (JAVA_HOME: ${JAVA_HOME:-unset}); set JAVA_HOME to one, or: brew install openjdk@21" >&2
      exit 3
    fi
  fi
fi
REPO="$(cd "$ROOT/../.." && pwd)"
MODULE_DIR="$(echo "${MODULE#:}" | tr ':' '/')"
if [ -z "$ANDROID_HOME" ] && [ -f "$REPO/local.properties" ]; then
  SDK_DIR="$(sed -n 's/^sdk\.dir=//p' "$REPO/local.properties" | tail -n 1)"
  [ -n "$SDK_DIR" ] && export ANDROID_HOME="$SDK_DIR"
fi
"$REPO/gradlew" -p "$REPO" -q --console=plain "$MODULE:installDist" >&2 || exit 3
APPCTL_ROOT="$ROOT" exec "$REPO/$MODULE_DIR/build/install/$NAME/bin/$NAME" "$@"
